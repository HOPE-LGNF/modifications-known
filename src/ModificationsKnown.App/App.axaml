<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.App"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1412" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#111815" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151D19" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2621" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3730" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F0EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A79D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#79C99E" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#93DDB4" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A2C" />
        <SolidColorBrush x:Key="AccentContrastBrush" Color="#0F1412" />
        <SolidColorBrush x:Key="ScrimBrush" Color="#CC080B09" />
        <SolidColorBrush x:Key="DialogScrimBrush" Color="#8C080B09" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#7DCE9A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E5B567" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E07A7A" />
        <SolidColorBrush x:Key="HeroStartBrush" Color="#1B3A2B" />
        <SolidColorBrush x:Key="HeroEndBrush" Color="#274D38" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Noto Sans CJK SC, sans-serif" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Noto Sans CJK SC, sans-serif" />
        </Style>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.modified">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.image-button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.image-button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="Border.mod-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style Selector="Border.mod-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <Style Selector="ListBoxItem:selected Border.mod-card">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Fluent's caption buttons are 30px tall and pinned to the top of the
             56px title bar (ExtendClientAreaTitleBarHeightHint). -->
        <Style Selector="chrome|CaptionButtons">
            <Setter Property="Margin" Value="0,13,0,0" />
        </Style>

        <Style Selector="Button.launch">
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.stat-pill">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="TextBlock.bepinex-state">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.bepinex-state.ready">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.step-marker">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.step-marker TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="Border.step-marker.done">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.step-marker.done TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style Selector="Border.hero">
            <Setter Property="Background" Value="{DynamicResource HeroStartBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="26" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="ListBox.tabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.mod-list">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.mod-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="ListBox.mod-list ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.mod-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.mod-list ListBoxItem:focus">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem:pointerover TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>
    </Application.Styles>
</Application>
