<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.UpdateModDialog"
                    Title="更新模组">
    <Grid>
        <Border Background="{DynamicResource DialogScrimBrush}" />
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="480"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                BoxShadow="0 20 56 0 #A0000000">
            <StackPanel Spacing="12">
                <TextBlock Name="TitleText" Text="更新模组" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Name="MessageText" Text="" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                <CheckBox Name="BackupCheck"
                          Content="备份旧版本（推荐）"
                          IsChecked="True" />
                <TextBlock Text="备份会复制到 MK 数据目录；即使不备份，更新失败也会尝试回滚旧目录。"
                           Classes="caption"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Name="CancelButton" Classes="Ghost" Content="取消" Click="OnCancelClick" />
                    <Button Name="ConfirmButton" Classes="Primary" Content="开始更新" Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</views:DialogWindow>
