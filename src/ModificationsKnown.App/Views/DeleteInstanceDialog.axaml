<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.DeleteInstanceDialog"
                    Title="删除版本">
    <Grid>
        <Border Name="DialogScrim"
                Opacity="0"
                Background="{DynamicResource DialogScrimBrush}" />

        <Border Name="DialogCard"
                Opacity="0"
                RenderTransform="scale(0.97)"
                RenderTransformOrigin="50%,50%"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="660"
                MaxHeight="720"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                BoxShadow="0 20 56 0 #A0000000">
            <Grid>
                <!-- Step 1: preserve saves + folder choice -->
                <StackPanel Name="StepOnePanel" Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="删除版本" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Name="InstanceLabel"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="InstancePath"
                                   FontSize="10"
                                   Classes="mono"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <TextBlock Text="存档处理" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="MK 为这个实例维护了独立存档目录。先决定如何保留它："
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <StackPanel Spacing="7">
                        <RadioButton Name="CopyRadio"
                                     GroupName="SaveMode"
                                     Content="复制到指定目录（推荐）"
                                     IsChecked="True"
                                     Checked="OnSaveModeChanged" />
                        <RadioButton Name="MoveRadio"
                                     GroupName="SaveMode"
                                     Content="移动到指定目录"
                                     Checked="OnSaveModeChanged" />
                        <RadioButton Name="KeepRadio"
                                     GroupName="SaveMode"
                                     Content="保持原位（不处理托管存档目录）"
                                     Checked="OnSaveModeChanged" />
                    </StackPanel>

                    <Grid Name="TargetRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Name="TargetBox" Watermark="存档保存目录" />
                        <Button Grid.Column="1"
                                Name="BrowseButton"
                                Classes="Ghost"
                                Content="选择目录"
                                Click="OnBrowseClick" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Name="SaveCountLabel"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="SaveList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="{Binding RelativePath}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SizeLabel}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="10,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Name="NoSavesLabel"
                                       Text="该实例还没有存档文件。"
                                       Classes="caption"
                                       IsVisible="False" />
                        </StackPanel>
                    </Border>

                    <CheckBox Name="DeleteFolderCheck"
                              Content="同时删除实例文件夹"
                              IsChecked="False" />
                    <TextBlock Text="勾选后会连同游戏安装目录一起删除。该目录中的 BepInEx、模组和日志都会消失，且无法恢复。"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="24,0,0,0" />

                    <TextBlock Name="StepOneError"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                        <Button Classes="Ghost" Content="取消" Click="OnCancelClick" />
                        <Button Classes="Primary" Content="下一步" Click="OnNextClick" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: red final confirmation -->
                <StackPanel Name="StepTwoPanel" Spacing="12" IsVisible="False">
                    <StackPanel Spacing="3">
                        <TextBlock Text="最终确认"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="以下操作不可撤销，请逐项核对。"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <TextBlock Name="SummaryText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>

                    <TextBlock Name="StepTwoError"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                        <Button Classes="Ghost" Content="返回" Click="OnBackClick" />
                        <Button Classes="Danger" Content="确认删除" Click="OnConfirmClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:DialogWindow>
