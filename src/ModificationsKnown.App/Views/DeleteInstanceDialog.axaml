<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.DeleteInstanceDialog"
                    Title="删除版本">
    <Grid>
        <Border Name="DialogScrim"
                Opacity="0"
                Background="{DynamicResource DialogScrimBrush}" />

        <Border Name="DialogCard"
                Opacity="0"
                RenderTransform="scale(0.97)"
                RenderTransformOrigin="50%,50%"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="660"
                MaxHeight="720"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                BoxShadow="0 20 56 0 #A0000000">
            <Grid>
                <!-- Step 1: what is removed, what is kept -->
                <StackPanel Name="StepOnePanel" Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="删除版本" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Name="InstanceLabel"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="InstancePath"
                                   FontSize="10"
                                   Classes="mono"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Name="SaveGroupsTitle"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="本操作只移除 MK 中的实例记录。所有存档组都保留在 MK 数据目录，不会被复制、移动、删除或重新链接；是否删除游戏安装目录也不会影响它们。"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <ItemsControl Name="SaveGroupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Margin="0,1"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Name="NoSaveGroupsLabel"
                                       Text="该实例当前没有登记存档组。"
                                       Classes="caption"
                                       IsVisible="False" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="将删除的 MK 记录"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="  · 版本别名与实例记录（刷新后不再出现）&#10;  · 该实例的 Mod 组快照&#10;  · 该实例的 Nexus 手动关联与安装来源记录"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <CheckBox Name="DeleteFolderCheck"
                              Content="同时删除游戏安装目录"
                              IsChecked="False" />
                    <TextBlock Name="SteamWarning"
                               IsVisible="False"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="24,0,0,0"
                               Text="该实例位于 Steam 库。直接删除文件夹会让 Steam 认为安装损坏；建议先关闭 MK，用 Steam 的“卸载”清理，或在 Steam 中验证文件。" />
                    <TextBlock Text="勾选后只删除游戏安装目录本身（BepInEx、模组与日志会消失，且无法恢复）。存档组不在该目录中，仍然全部保留。"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="24,0,0,0" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                        <Button Classes="Ghost" Content="取消" Click="OnCancelClick" />
                        <Button Classes="Primary" Content="下一步" Click="OnNextClick" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: final confirmation -->
                <StackPanel Name="StepTwoPanel" Spacing="12" IsVisible="False">
                    <StackPanel Spacing="3">
                        <TextBlock Text="最终确认"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="请逐项核对；存档组不会受本次操作影响。"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <TextBlock Name="SummaryText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                        <Button Classes="Ghost" Content="返回" Click="OnBackClick" />
                        <Button Name="ConfirmDeleteButton" Classes="Danger" Content="确认删除" Click="OnConfirmClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:DialogWindow>
