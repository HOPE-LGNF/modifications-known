<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.SettingsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1120" HorizontalAlignment="Center">

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="游戏与版本" Classes="h2" />
                    <TextBlock Text="启动器会优先读取 Steam 的 appmanifest；也可以手动指定 .exe 或游戏目录。每个检测到的目录都是一个独立实例，拥有自己的 BepInEx/plugins、存档和 Mod 组。"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding GamePath, Mode=TwoWay}"
                                 Watermark="例如 D:\SteamLibrary\steamapps\common\Casualties Unknown" />
                        <Button Grid.Column="1" Content="选文件" Command="{Binding BrowseGameCommand}" />
                        <Button Grid.Column="2" Content="选目录" Command="{Binding BrowseGameFolderCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary" Content="检测此路径" Command="{Binding DetectGameCommand}" />
                        <TextBlock Text="检测成功后会自动选中该版本。"
                                   Classes="caption"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />

                    <TextBlock Text="已检测版本" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="重命名只改显示名，不改目录；切换当前版本会影响首页、已安装页和 Mod 组。"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="启动前会自动把 %LocalLow%\Orsoniks\CasualtiesUnknown 指向当前版本的独立存档目录，避免正式版与 Demo 共用 save.sv。若从 MK 之外启动游戏，游戏会写入最后一次由 MK 选中的版本存档。"
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding GameVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBox Text="{Binding Alias, Mode=TwoWay}"
                                                         Width="170"
                                                         Watermark="版本显示名"
                                                         KeyDown="OnAliasKeyDown" />
                                                <TextBlock Text="{Binding EditionLabel}" Classes="caption" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LoaderLabel}" Classes="caption" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsCurrent}">
                                                    <TextBlock Text="当前" FontSize="9" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}"
                                                       Classes="mono"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{Binding SaveAliasText}"
                                                    Command="{Binding SaveAliasCommand}"
                                                    IsVisible="{Binding IsAliasDirty}"
                                                    IsEnabled="{Binding CanSaveAlias}"
                                                    Classes.modified="{Binding IsAliasDirty}" />
                                            <Button Classes="Ghost" Content="设为当前" Command="{Binding SelectCommand}" />
                                            <Button Classes="Ghost"
                                                    Content="安装 BepInEx"
                                                    IsVisible="{Binding CanInstallLoader}"
                                                    Command="{Binding InstallLoaderCommand}" />
                                            <Button Classes="Danger"
                                                    Content="删除版本"
                                                    Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="Ghost"
                                Content="GitHub BepInEx Releases"
                                Command="{Binding OpenBepInExPageCommand}" />
                        <Button Classes="Ghost"
                                Content="Thunderstore · BepInExPack"
                                Command="{Binding OpenThunderstoreBepInExCommand}" />
                        <Button Classes="Ghost"
                                Content="Nexus · BepInEx 搜索"
                                Command="{Binding OpenNexusBepInExSearchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nexus Mods" Classes="h2" />
                    <TextBlock Text="API Key 只保存在本机 AppData 的 settings.json 中，不会写入日志。免费账号可能无法直接生成下载链接，此时请使用“在 Nexus 打开”。"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="API Key" Classes="muted" />
                            <Border Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    ToolTip.Tip="MK 用 API Key 读取 Nexus 的模组、文件和下载授权；只保存在本机，不会发送给第三方。">
                                <TextBlock Text="?"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NexusApiKey, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Watermark="粘贴 Nexus 个人 API Key" />
                        <Button Grid.Column="2" Classes="Ghost" Content="获取 API Key" Command="{Binding OpenApiKeyPageCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="游戏域" Classes="muted" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding NexusDomain, Mode=TwoWay}"
                                 Watermark="scavprototype" />
                        <Button Grid.Column="2" Content="测试连接" Command="{Binding TestNexusCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="账号类型" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AccountStatus}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="Ghost" Content="检查账号" Command="{Binding CheckAccountCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ConnectionStatus}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,160,Auto,120,Auto,*" ColumnSpacing="10">
                        <TextBlock Text="每页数量" Classes="muted" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding PageSize, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="100"
                                       Increment="1" />
                        <TextBlock Grid.Column="2" Text="包含成人内容" Classes="muted" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="3"
                                      IsChecked="{Binding IncludeAdultMods, Mode=TwoWay}"
                                      OnContent="是"
                                      OffContent="否" />
                        <TextBlock Grid.Column="4"
                                   Text="默认关闭；开启后搜索结果会包含成人模组。"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="浏览器集成（NXM）" Classes="h2" />
                        <Border Width="16" Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ToolTip.Tip="注册后，浏览器里的 Mod manager download 会把 nxm:// 链接交给 MK；免费账号靠它获取下载授权，而不是仅凭 API Key。">
                            <TextBlock Text="?"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="注册后，Nexus 页面点击“Mod manager download”会通过 nxm:// 回到启动器。只写入当前用户 HKCU，不需要管理员权限；已存在其他 handler 时会拒绝覆盖。"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NxmProtocolStatus}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary"
                                Content="注册 NXM 链接"
                                IsVisible="{Binding NxmProtocolSupported}"
                                Command="{Binding RegisterNxmProtocolCommand}" />
                        <Button Classes="Ghost"
                                Content="取消注册"
                                IsVisible="{Binding NxmProtocolRegistered}"
                                Command="{Binding UnregisterNxmProtocolCommand}" />
                    </StackPanel>
                    <TextBlock Text="应用运行时浏览器会复用当前窗口；应用未运行时会启动它。"
                               Classes="caption" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="行为与日志" Classes="h2" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="删除确认" Classes="muted" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding ConfirmBeforeDelete, Mode=TwoWay}"
                                      OnContent="开启"
                                      OffContent="关闭" />
                        <Button Grid.Column="2" Classes="Ghost" Content="打开日志目录" Command="{Binding OpenLogsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SettingsPath}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogDirectory}"
                               Classes="mono"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <Button Classes="Primary" Content="保存设置" Command="{Binding SaveCommand}" />
                <TextBlock Text="修改后需要保存；API Key 测试会先使用当前输入。"
                           Classes="caption"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
