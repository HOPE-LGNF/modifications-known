<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.UninstallBepInExDialog"
                    Title="卸载 BepInEx">
    <Grid>
        <Border Background="{DynamicResource DialogScrimBrush}" />
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="580"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                BoxShadow="0 20 56 0 #A0000000">
            <Grid>
                <StackPanel Name="StepOnePanel" Spacing="12">
                    <TextBlock Text="卸载 BepInEx" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Name="InstanceLabel" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                    <TextBlock Name="InstancePath" Classes="mono muted" FontSize="10" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="会删除：" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="· BepInEx/ 整个目录（core、plugins、config、日志）" FontSize="11" />
                            <TextBlock Text="· winhttp.dll / doorstop_config.ini / .doorstop_version" FontSize="11" />
                            <TextBlock Text="此实例下的所有模组都会一起删除，且无法从 MK 恢复。"
                                       FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <CheckBox Name="AcknowledgeCheck"
                              Content="我已知晓：这会删除此实例的所有模组"
                              Checked="OnAcknowledgeChanged"
                              Unchecked="OnAcknowledgeChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Ghost" Content="取消" Click="OnCancelClick" />
                        <Button Name="ContinueButton" Classes="Danger" Content="继续" IsEnabled="False" Click="OnContinueClick" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Name="StepTwoPanel" Spacing="12" IsVisible="False">
                    <TextBlock Text="最终确认" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Name="SummaryText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <TextBlock Text="卸载后，游戏将不再加载任何 BepInEx 模组。需要重新安装 BepInEx 才能恢复。"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Ghost" Content="返回" Click="OnBackClick" />
                        <Button Name="ConfirmButton" Classes="Danger" Content="确认卸载（5）" IsEnabled="False" Click="OnConfirmClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:DialogWindow>
