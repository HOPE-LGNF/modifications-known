<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModificationsKnown.App.Views.LinkNexusDialog"
        Width="680"
        Height="540"
        MinWidth="520"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Title="关联 Nexus 模组">
    <Border Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="关联 Nexus 模组" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="搜索并选择一个最接近的 Nexus 模组。关联结果会保存在本机，用于后续更新检测。"
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Name="SearchBox"
                         Watermark="输入模组名称或关键词"
                         KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1"
                        Classes="Primary"
                        Content="搜索"
                        Click="OnSearchClick" />
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <ListBox Name="Results"
                         Background="Transparent"
                         BorderThickness="0"
                         DoubleTapped="OnResultDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="4,5">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Author}" Classes="caption" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Category}" Classes="caption" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           Name="StatusText"
                           Classes="caption"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消" Click="OnCancelClick" />
                <Button Classes="Primary" Content="关联选中项" Click="OnLinkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
