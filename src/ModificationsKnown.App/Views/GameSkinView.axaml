<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.GameSkinView">
    <!-- The "施工中" veil is owned by MainWindow so it covers the header and
         status bar as well. This page only carries the planned content. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <Border Classes="hero">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="游戏皮肤" FontSize="28" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="6"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="计划中的能力" Classes="h2" />
                    <ItemsControl ItemsSource="{Binding PlannedFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="18,*" Margin="0,3">
                                    <TextBlock Text="·" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               Classes="muted"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
