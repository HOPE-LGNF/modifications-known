<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.HomeView">
    <Grid ColumnDefinitions="340,*" ColumnSpacing="16">

        <Border Classes="card" Padding="22">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="本地模组工作台"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding GameTitle}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GameSubtitle}"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <Border Margin="0,12,0,0"
                            Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            IsVisible="{Binding HasGame}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding GamePath}"
                                       Classes="mono"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding GamePath}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="BepInEx" Classes="caption" />
                                        <TextBlock Text="{Binding BepInExShortLabel}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Classes="bepinex-state"
                                                   Classes.ready="{Binding BepInExReady}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已安装" Classes="caption" />
                                        <TextBlock Text="{Binding ModCountLabel, StringFormat='{}{0} 个包'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="启用中" Classes="caption" />
                                        <TextBlock Text="{Binding EnabledCountLabel, StringFormat='{}{0} 个'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,4,0,0">
                        <Button Classes="Ghost"
                                Content="打开游戏目录"
                                IsVisible="{Binding HasGame}"
                                Command="{Binding OpenFolderCommand}" />
                        <Button Classes="Ghost"
                                Content="重新检测"
                                ToolTip.Tip="重新检测 Steam 库和手动路径"
                                Command="{Binding RefreshGameCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Button Classes="Primary launch"
                            Content="{Binding $parent[Window].DataContext.LaunchButtonText}"
                            IsEnabled="{Binding $parent[Window].DataContext.CanLaunch}"
                            Command="{Binding $parent[Window].DataContext.LaunchGameCommand}" />
                    <TextBlock Text="启动前会自动切换到该版本的独立存档。"
                               Classes="caption"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="已安装模组" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding ModCountLabel}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="BepInEx/plugins 中的包" Classes="caption" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="当前启用" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding EnabledCountLabel}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="会随游戏加载" Classes="caption" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nexus 账号" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding NexusAccountLabel}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding NexusAccountDetail}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="从这里开始" Classes="h2" />
                        <ItemsControl ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="14,10"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="12"
                                                    VerticalAlignment="Center"
                                                    Classes.done="{Binding IsDone}"
                                                    Classes="step-marker">
                                                <TextBlock Text="{Binding Marker}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="Ghost"
                                                    Content="{Binding ActionText}"
                                                    IsVisible="{Binding IsPending}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].DataContext.GoToCommand}"
                                                    CommandParameter="{Binding TargetPage}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="安装或启用模组前，建议先关闭游戏：BepInEx 只在启动时扫描 DLL。"
                                   Classes="caption"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
