<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.HomeView">
    <Grid ColumnDefinitions="360,*" ColumnSpacing="18">

        <!-- Launch column -->
        <Border Classes="card" Padding="22">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="本地模组工作台"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding GameTitle}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GameSubtitle}"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <Border Margin="0,12,0,0"
                            Padding="13,11"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            IsVisible="{Binding HasGame}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="{Binding GamePath}"
                                       Classes="mono"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding GamePath}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                                <Border Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="BepInEx" Classes="caption" />
                                        <TextBlock Text="{Binding BepInExShortLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Classes="bepinex-state"
                                                   Classes.ready="{Binding BepInExReady}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已安装模组" Classes="caption" />
                                        <TextBlock Text="{Binding ModCountLabel, StringFormat='{}{0} 个包'}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="stat-pill">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="启用中" Classes="caption" />
                                        <TextBlock Text="{Binding EnabledCountLabel, StringFormat='{}{0} 个'}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="-8,2,0,0">
                        <Button Classes="Ghost"
                                Content="打开游戏目录"
                                IsVisible="{Binding HasGame}"
                                Command="{Binding OpenFolderCommand}" />
                        <Button Classes="Ghost"
                                Content="重新检测"
                                Command="{Binding RefreshGameCommand}" />
                    </StackPanel>

                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,10,0,6"
                            IsVisible="{Binding HasGame}" />

                    <StackPanel Spacing="8" IsVisible="{Binding HasGame}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="运行状态" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RunningLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="上次启动" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding LastLaunchLabel}" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="存档隔离" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SaveIsolationLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="当前 Mod 组" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentGroupLabel}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Classes="Primary launch"
                            Classes.danger="{Binding IsCloseAction}"
                            Content="{Binding LaunchButtonText}"
                            Command="{Binding LaunchGameCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard column -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="已安装模组" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding ModCountLabel}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="BepInEx/plugins 中的包" Classes="caption" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="当前启用" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding EnabledCountLabel}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="会随游戏加载" Classes="caption" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nexus 账号" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding NexusAccountLabel}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding NexusAccountDetail}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Name="DashboardGrid"
                      ColumnDefinitions="2*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="16">
                    <Border Name="ChecklistCard"
                            Grid.RowSpan="2"
                            Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="从这里开始" Classes="h2" />
                            <ItemsControl ItemsSource="{Binding Checklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="14,10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="24" Height="24"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Center"
                                                        Classes="step-marker"
                                                        Classes.done="{Binding IsDone}">
                                                    <TextBlock Text="{Binding Marker}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Classes="Ghost"
                                                        Content="{Binding ActionText}"
                                                        IsVisible="{Binding IsPending}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].DataContext.ChecklistActionCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="安装或启用模组前，建议先关闭游戏：BepInEx 只在启动时扫描 DLL。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Name="ActivityCard"
                            Grid.Column="1"
                            Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="最近活动" Classes="h2" />
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,9">
                                            <Border Width="24" Height="24" CornerRadius="7"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="caption"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RelativeTime}"
                                                       Classes="caption"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无活动记录。"
                                       Classes="caption"
                                       IsVisible="{Binding HasNoActivity}" />
                        </StackPanel>
                    </Border>

                    <Border Name="DataCard"
                            Grid.Column="1"
                            Grid.Row="1"
                            Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="存档与数据" Classes="h2" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="当前存档组" Classes="caption" />
                                <TextBlock Text="{Binding SaveGroupLabel}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="存档组目录" Classes="caption" />
                                <TextBlock Text="{Binding SaveProfilePath}"
                                           Classes="mono"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="数据目录" Classes="caption" />
                                <TextBlock Text="{Binding DataRoot}"
                                           Classes="mono"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Classes="Ghost"
                                    Content="管理存档 →"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Command="{Binding GoToCommand}"
                                    CommandParameter="saves" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
