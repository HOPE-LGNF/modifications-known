<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.ConfirmDialog"
                    Title="确认">
    <Grid>
        <!-- Dim + blur the app behind the modal. -->
        <Border Background="{DynamicResource DialogScrimBrush}" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="400"
                MaxWidth="520"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="26,24"
                BoxShadow="0 20 56 0 #A0000000">
            <StackPanel Spacing="14">
                <TextBlock Name="TitleText"
                           Text="确认"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Name="MessageText"
                           Text=""
                           Classes="muted"
                           FontSize="13"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Name="CancelButton"
                            Classes="Ghost"
                            Content="取消"
                            Click="OnCancelClick" />
                    <Button Name="ConfirmButton"
                            Classes="Primary"
                            Content="确认"
                            Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</views:DialogWindow>
