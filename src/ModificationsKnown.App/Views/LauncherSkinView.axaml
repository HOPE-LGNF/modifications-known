<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.LauncherSkinView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="启动器外观" Classes="h2" />
                        <TextBlock Text="{Binding Explanation}"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="680" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,6,0,0">
                            <Button Content="导入主题 JSON"
                                    Command="{Binding ImportThemeCommand}" />
                            <TextBlock Text="支持 .json；导入后可在下方列表中选择"
                                       Classes="caption"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="190"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="当前主题"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding CurrentThemeName}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Margin="0,0,14,14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <Border Height="86"
                                        CornerRadius="8"
                                        Background="{Binding BackgroundBrush}"
                                        ClipToBounds="True">
                                    <Grid ColumnDefinitions="38,*">
                                        <Border Background="{Binding SurfaceBrush}" Margin="8" CornerRadius="5" />
                                        <StackPanel Grid.Column="1" Margin="4,12,12,12" Spacing="6">
                                            <Border Height="8"
                                                    Width="90"
                                                    CornerRadius="4"
                                                    Background="{Binding AccentBrush}"
                                                    HorizontalAlignment="Left" />
                                            <Border Height="5"
                                                    Width="160"
                                                    CornerRadius="3"
                                                    Background="{Binding TextBrush}"
                                                    Opacity="0.55"
                                                    HorizontalAlignment="Left" />
                                            <Border Height="5"
                                                    Width="120"
                                                    CornerRadius="3"
                                                    Background="{Binding TextBrush}"
                                                    Opacity="0.3"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="45" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="当前"
                                               IsVisible="{Binding IsSelected}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Top" />
                                </Grid>

                                <Button Content="应用此主题"
                                        Command="{Binding ApplyCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


        </StackPanel>
    </ScrollViewer>
</UserControl>
