<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.InstalledView">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="已安装模组" Classes="h2" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountLabel, StringFormat='{}{0} 个包'}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding EnabledLabel, StringFormat='已启用 {0}'}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding PluginsPath}"
                           Classes="mono"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Ghost" Content="{Binding ViewModeButtonText}" Command="{Binding ToggleViewModeCommand}" />
                <Button Classes="Ghost" Content="全部启用" Command="{Binding EnableAllCommand}" />
                <Button Classes="Ghost" Content="全部禁用" Command="{Binding DisableAllCommand}" />
                <Button Classes="Ghost" Content="安装已下载文件" Command="{Binding InstallLocalArchiveCommand}" />
                <Button Classes="Ghost" Content="打开插件目录" Command="{Binding OpenPluginsFolderCommand}" />
                <Button Content="重新扫描" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 Watermark="搜索已安装模组…"
                 Margin="0,2,0,0" />

        <Border Grid.Row="2"
                IsVisible="{Binding BepInExMissing}"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9">
            <TextBlock Text="当前游戏没有 BepInEx/plugins。模组发现可以浏览，但安装按钮不会工作。"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding EmptyMessage}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12"
                                        Margin="0,0,0,7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding IsEnabled}" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           IsVisible="{Binding IsDisabled}" />
                                                <TextBlock Text="{Binding Version}" Classes="caption" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,2">
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="9" Classes="muted" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,2">
                                                    <TextBlock Text="{Binding ManagementLabel}" FontSize="9" Classes="muted" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding IsDetailed}" Spacing="3">
                                                <TextBlock Text="{Binding PackagePath}"
                                                           Classes="mono"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{Binding PluginLabel}" Classes="caption" />
                                                    <TextBlock Text="{Binding DependencyLabel}" Classes="caption" />
                                                    <TextBlock Text="{Binding FileStateLabel}"
                                                               Classes="caption"
                                                               ToolTip.Tip="{Binding FileStateTooltip}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="Ghost"
                                                    Content="接管"
                                                    IsVisible="{Binding CanAdopt}"
                                                    Command="{Binding AdoptCommand}" />
                                            <Button Classes="Ghost"
                                                    Content="Nexus"
                                                    IsVisible="{Binding IsNexusMatched}"
                                                    Command="{Binding OpenNexusCommand}" />
                                            <Button Classes="Ghost"
                                                    Content="关联 Nexus"
                                                    Command="{Binding LinkNexusCommand}" />
                                            <Button Classes="Danger"
                                                    Content="卸载"
                                                    IsVisible="{Binding CanDelete}"
                                                    Command="{Binding UninstallCommand}" />
                                            <Button Classes="Danger"
                                                    Content="删除目录"
                                                    IsVisible="{Binding CanDeleteWhole}"
                                                    Command="{Binding DeleteWholeCommand}" />
                                            <CheckBox Content="启用"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         IsVisible="{Binding IsBusy}"
                         IsHitTestVisible="False"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,2" />
        </Grid>
    </Grid>
</UserControl>
