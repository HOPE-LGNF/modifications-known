<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModificationsKnown.App.Views.SavesView">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="存档管理" Classes="h2" />
                <TextBlock Text="每个版本都有独立的托管存档目录；正式版与试玩版不会串档。备份会把文件复制到你选择的目录。"
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="Primary"
                    Content="刷新"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="{Binding EmptyMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       IsVisible="{Binding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Instances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="5"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLive}">
                                                <TextBlock Text="当前存档"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="Ghost" Content="打开目录" Command="{Binding OpenCommand}" />
                                            <Button Classes="Ghost" Content="备份…" Command="{Binding BackupCommand}" />
                                            <Button Classes="Danger"
                                                    Content="删除存档"
                                                    IsEnabled="{Binding !IsLive}"
                                                    Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding ProfilePath}"
                                               Classes="mono"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <TextBlock Text="{Binding FileCountLabel}" Classes="caption" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UpdatedLabel, StringFormat='最后更新 {0}'}"
                                                   Classes="caption" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding !IsEmpty}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Text="{Binding RelativePath}" Classes="mono" FontSize="10" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SizeLabel}"
                                                               Classes="caption"
                                                               Margin="10,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="还没有存档文件。首次从 MK 启动游戏后会出现。"
                                               Classes="caption"
                                               IsVisible="{Binding IsEmpty}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
