<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:ModificationsKnown.App.Views"
                    x:Class="ModificationsKnown.App.Views.VersionPickerDialog"
                    Title="选择版本">
    <Grid>
        <Border Name="DialogScrim"
                Opacity="0"
                Background="{DynamicResource DialogScrimBrush}" />

        <Border Name="DialogCard"
                Opacity="0"
                RenderTransform="scale(0.97)"
                RenderTransformOrigin="50%,50%"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="540"
                MaxHeight="660"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                BoxShadow="0 20 56 0 #A0000000">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="选择要安装的文件和版本"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedCard.Name}"
                               Classes="caption"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="文件"
                           Classes="muted"
                           FontSize="11"
                           Margin="0,4,0,0" />
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UploadedLabel}"
                                           Classes="caption"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6" Margin="0,4,0,0">
                    <TextBlock Text="版本"
                               Classes="muted"
                               FontSize="11" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding VersionLabel}" FontSize="12" />
                                            <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Classes="muted" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">
                    <Button Classes="Ghost" Content="取消" Click="OnCancelClick" />
                    <Button Classes="Primary"
                            Content="下载并安装此版本"
                            IsEnabled="{Binding SelectedVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Click="OnDownloadClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:DialogWindow>
