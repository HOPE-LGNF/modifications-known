<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModificationsKnown.App.ViewModels"
        xmlns:views="using:ModificationsKnown.App.Views"
        x:Class="ModificationsKnown.App.Views.MainWindow"
        Title="已知改装 / Modifications Known"
        Width="1240" Height="800"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="56"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
            <views:InstalledView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherSkinViewModel}">
            <views:LauncherSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameSkinViewModel}">
            <views:GameSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="56,*,Auto">
        <Grid Grid.Row="0">
            <Border Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnTitleBarPointerPressed"
                    DoubleTapped="OnTitleBarDoubleTapped" />

            <Grid ColumnDefinitions="Auto,*,Auto,138" Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="32" Height="32"
                            CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <TextBlock Text="MK"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="已知改装"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="MODIFICATIONS KNOWN"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="tabs"
                         Margin="20,0,12,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        ToolTip.Tip="{Binding Subtitle}">
                                <TextBlock Text="{Binding Title}"
                                           Classes="tab-title"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Border IsVisible="{Binding HasBadge}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="5"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ComboBox Grid.Column="2"
                          Width="200"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Game.Installations}"
                          SelectedItem="{Binding Game.Selected, Mode=TwoWay}"
                          PlaceholderText="未检测到游戏"
                          AutomationProperties.Name="当前游戏实例">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  ToolTip.Tip="{Binding GameDirectory}">
                                <TextBlock Text="{Binding DisplayLabel}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BepInExLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Grid>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        Margin="24,20" />

        <Border Grid.Row="2"
                Padding="24,8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="7" Height="7"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding FooterText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Transient page-top hint (mirrors the status bar). -->
        <Border Grid.Row="1"
                ZIndex="15"
                IsHitTestVisible="False"
                IsVisible="{Binding IsToastVisible}"
                Opacity="{Binding ToastOpacity}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                MaxWidth="640"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{Binding ToastBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                BoxShadow="0 8 24 0 #80000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Fill="{Binding ToastBrush}" />
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="11"
                           MaxWidth="560"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.22"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- The game-skin page is a placeholder: veil the whole page row
             edge-to-edge, but keep the title bar and the status bar usable. -->
        <Border Grid.Row="1"
                ZIndex="20"
                Background="{DynamicResource ScrimBrush}"
                IsVisible="{Binding IsGameSkinOverlayVisible}">
            <Border Width="430"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="施工中"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="游戏皮肤管理正在开发中。"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="这个版本不会读取或修改 Body / Head / Wings 等游戏皮肤目录。请先使用模组管理功能。"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Hit-testable on purpose: once shown it is the only drop target, so
             moving between child controls cannot fire DragLeave and flicker. -->
        <Border Name="DropOverlay"
                Grid.RowSpan="3"
                ZIndex="30"
                IsVisible="False"
                Background="{DynamicResource ScrimBrush}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36,26"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="安装模组压缩包"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DropHint}"
                               Classes="muted"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
