<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModificationsKnown.App.ViewModels"
        xmlns:views="using:ModificationsKnown.App.Views"
        x:Class="ModificationsKnown.App.Views.MainWindow"
        Title="已知改装 / Modifications Known"
        Icon="/Assets/ModificationsKnown-64.png"
        Width="1240" Height="780"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="64"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
            <views:InstalledView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavesViewModel}">
            <views:SavesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
            <views:LogViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherSkinViewModel}">
            <views:LauncherSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameSkinViewModel}">
            <views:GameSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="64,*,Auto">
        <!-- Custom title bar -->
        <Grid Grid.Row="0">
            <Border Name="TitleBarDragArea"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnTitleBarPointerPressed"
                    DoubleTapped="OnTitleBarDoubleTapped" />

            <Grid ColumnDefinitions="Auto,*,Auto,150" Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Image Source="/Assets/ModificationsKnown-32.png"
                           Width="32" Height="32"
                           Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="已知改装" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="MODIFICATIONS KNOWN"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0">
                                <TextBlock Text="BETA"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Centred, horizontally scrollable tabs (no visible scrollbar). -->
                <ScrollViewer Grid.Column="1"
                              Name="TitleTabsScroll"
                              Margin="6,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="OnTabsPointerWheel">
                    <ListBox Name="TitleTabs"
                             Classes="tabs"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             HorizontalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            ToolTip.Tip="{Binding Subtitle}">
                                    <TextBlock Text="{Binding Title}"
                                               Classes="tab-title"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <Border IsVisible="{Binding HasBadge}"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="5"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <ComboBox Classes="instance-pill"
                              Width="240"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Game.Installations}"
                              SelectedItem="{Binding Game.Selected, Mode=TwoWay}"
                              PlaceholderText="未选择版本">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            ToolTip.Tip="{Binding GameDirectory}">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PillLabel}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="1"
                            Margin="0,0,5,0">
                    <Button Classes="window-button"
                            Click="OnMinimizeClick"
                            ToolTip.Tip="最小化">
                        <Path Data="M2,8 L14,8"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.2"
                              StrokeLineCap="Square" />
                    </Button>
                    <Button Classes="window-button"
                            Click="OnMaximizeClick"
                            ToolTip.Tip="最大化 / 还原">
                        <Panel Width="16" Height="16">
                            <Path Name="MaximizeIcon"
                                  Data="M2,2 L14,2 L14,14 L2,14 Z"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.2" />
                            <Path Name="RestoreIcon"
                                  Data="M5,2 L14,2 L14,11 M2,5 L11,5 L11,14 L2,14 Z"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.2"
                                  IsVisible="False" />
                        </Panel>
                    </Button>
                    <Button Classes="window-button close"
                            Click="OnCloseClick"
                            ToolTip.Tip="关闭">
                        <Path Data="M2,2 L14,14 M14,2 L2,14"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.2"
                              StrokeLineCap="Square" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        Margin="24,20" />

        <Border Grid.Row="2"
                Padding="24,8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="7" Height="7"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding FooterText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Transient page-top hint (mirrors the status bar). -->
        <Border Grid.Row="1"
                ZIndex="15"
                IsHitTestVisible="False"
                IsVisible="{Binding IsToastVisible}"
                Opacity="{Binding ToastOpacity}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="640"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{Binding ToastBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                BoxShadow="0 8 24 0 #80000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="7" Height="7"
                         VerticalAlignment="Center"
                         Fill="{Binding ToastBrush}" />
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="11"
                           MaxWidth="560"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.22"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Game-skin placeholder veil: page row only. -->
        <Border Grid.Row="1"
                ZIndex="20"
                Background="{DynamicResource ScrimBrush}"
                IsVisible="{Binding IsGameSkinOverlayVisible}">
            <Border Width="430"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="施工中"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="游戏皮肤管理正在开发中。"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="这个版本不会读取或修改 Body / Head / Wings 等游戏皮肤目录。请先使用模组管理功能。"
                               Classes="muted"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Drag-and-drop installation overlay -->
        <Border Name="DropOverlay"
                Grid.RowSpan="3"
                ZIndex="30"
                IsVisible="False"
                Background="{DynamicResource ScrimBrush}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36,26"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="安装模组压缩包"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DropHint}"
                               Classes="muted"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
