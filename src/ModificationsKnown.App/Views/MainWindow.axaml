<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModificationsKnown.App.ViewModels"
        xmlns:views="using:ModificationsKnown.App.Views"
        x:Class="ModificationsKnown.App.Views.MainWindow"
        Title="已知改装 / Modifications Known"
        Width="1240" Height="800"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
            <views:InstalledView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherSkinViewModel}">
            <views:LauncherSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameSkinViewModel}">
            <views:GameSkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="264,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Margin="22,26,22,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <Border Width="40" Height="40"
                                CornerRadius="11"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1">
                            <TextBlock Text="MK"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="已知改装"
                                       FontSize="21"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="MODIFICATIONS KNOWN"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="为《未知伤亡》整理模组，而不是和文件搏斗。"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Classes="nav"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         Margin="12,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,9">
                                <TextBlock Text="{Binding Glyph}"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        IsVisible="{Binding HasBadge}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="5"
                                        Padding="5,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="9"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="22,20" Spacing="4">
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Apache-2.0 · 本地优先"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0"
                    Padding="28,18"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNavigation.Title}"
                                   Classes="h1" />
                        <TextBlock Text="本地模组状态与 Nexus 浏览分开管理；所有安装操作都先经过校验。"
                                   Classes="caption"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <ComboBox Width="270"
                                  ItemsSource="{Binding Game.Installations}"
                                  SelectedItem="{Binding Game.Selected, Mode=TwoWay}"
                                  PlaceholderText="未检测到游戏">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Margin="4,2">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12" />
                                        <TextBlock Text="{Binding Profile.EditionLabel}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="Ghost"
                                Content="刷新"
                                Command="{Binding RefreshGameCommand}"
                                ToolTip.Tip="重新检测 Steam 库和手动路径" />
                        <Button Classes="Primary"
                                Content="{Binding LaunchButtonText}"
                                IsEnabled="{Binding CanLaunch}"
                                Command="{Binding LaunchGameCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="28,22" />

            <Border Grid.Row="2"
                    Padding="28,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="7" Height="7"
                             Fill="{Binding StatusBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentGameLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Transient page-top hint (mirrors the status bar). -->
            <Border Grid.Row="1"
                    ZIndex="15"
                    IsVisible="{Binding IsToastVisible}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,20,0"
                    MaxWidth="460"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{Binding ToastBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,8"
                    BoxShadow="0 8 24 0 #80000000">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Fill="{Binding ToastBrush}" />
                    <TextBlock Text="{Binding ToastMessage}"
                               FontSize="11"
                               MaxWidth="400"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- The game-skin page is a placeholder: veil the whole page row
                 edge-to-edge, but keep the top game/launch bar and the status
                 bar usable. -->
            <Border Grid.Row="1"
                    ZIndex="20"
                    Background="{DynamicResource ScrimBrush}"
                    IsVisible="{Binding IsGameSkinOverlayVisible}">
                <Border Width="430"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="施工中"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="游戏皮肤管理正在开发中。"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="这个版本不会读取或修改 Body / Head / Wings 等游戏皮肤目录。请先使用模组管理功能。"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
